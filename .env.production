# =============================================================================
# 🚀 AI图像提示生成器 - 生产环境配置
# =============================================================================
# ⚠️ 重要: 这是生产环境配置模板，部署前请替换所有占位符值
# =============================================================================

# -----------------------------------------------------------------------------
# 🌐 应用程序配置
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL='https://your-domain.com'
NODE_ENV='production'

# -----------------------------------------------------------------------------
# 🔐 认证服务 (Clerk)
# 🔗 获取密钥: https://clerk.com/dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_live_REPLACE_WITH_PRODUCTION_KEY'
CLERK_SECRET_KEY='sk_live_REPLACE_WITH_PRODUCTION_KEY'
SKIP_ENV_VALIDATION=false

# -----------------------------------------------------------------------------
# 📧 邮件服务 (RESEND)
# 🔗 获取密钥: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY='re_REPLACE_WITH_PRODUCTION_KEY'
RESEND_FROM='noreply@your-domain.com'

# -----------------------------------------------------------------------------
# 💳 支付服务 (Stripe)
# 🔗 获取密钥: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_API_KEY='sk_live_REPLACE_WITH_PRODUCTION_KEY'
STRIPE_WEBHOOK_SECRET='whsec_REPLACE_WITH_PRODUCTION_WEBHOOK_SECRET'

# Stripe产品配置 (从Stripe Dashboard获取)
NEXT_PUBLIC_STRIPE_STD_PRODUCT_ID='prod_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_STD_MONTHLY_PRICE_ID='price_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_PRO_PRODUCT_ID='prod_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID='price_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID='price_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_BUSINESS_PRODUCT_ID='prod_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID='price_REPLACE_WITH_ACTUAL_ID'
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID='price_REPLACE_WITH_ACTUAL_ID'

# -----------------------------------------------------------------------------
# 📊 分析和监控 (PostHog)
# 🔗 获取密钥: https://app.posthog.com/project/settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY='phc_REPLACE_WITH_PRODUCTION_KEY'
NEXT_PUBLIC_POSTHOG_HOST='https://app.posthog.com'

# -----------------------------------------------------------------------------
# 👤 管理员配置
# -----------------------------------------------------------------------------
ADMIN_EMAIL='admin@your-domain.com,ops@your-domain.com'

# -----------------------------------------------------------------------------
# 🤖 AI图像分析服务 (生产环境)
# -----------------------------------------------------------------------------
AI_SERVICE_PROVIDER='coze'

# Coze生产环境配置
COZE_API_TOKEN='pat_REPLACE_WITH_PRODUCTION_TOKEN'
COZE_API_BASE_URL='https://api.coze.cn'
COZE_WORKFLOW_ID='REPLACE_WITH_PRODUCTION_WORKFLOW_ID'

# OpenAI备用配置 (可选)
OPENAI_API_KEY='sk-REPLACE_WITH_PRODUCTION_KEY'
OPENAI_API_BASE_URL='https://api.openai.com/v1'
OPENAI_MODEL='gpt-4-vision-preview'

# -----------------------------------------------------------------------------
# 📁 文件处理配置 (生产级限制)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES='jpg,jpeg,png,webp'

# -----------------------------------------------------------------------------
# 🛡️ 安全和限流配置 (生产环境)
# -----------------------------------------------------------------------------
# API速率限制 (严格)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=50
RATE_LIMIT_PER_DAY=200

# 功能开关 (生产环境启用)
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_LOGGING=true
ENABLE_ANALYTICS=true

# 安全配置
ENABLE_CORS_PROTECTION=true
ENABLE_CSP_HEADERS=true
ENABLE_SECURITY_HEADERS=true

# -----------------------------------------------------------------------------
# 🗄️ 数据库配置 (生产环境)
# -----------------------------------------------------------------------------
POSTGRES_URL='postgresql://username:password@your-db-host:5432/your_production_db'
DATABASE_URL='postgresql://username:password@your-db-host:5432/your_production_db'

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# -----------------------------------------------------------------------------
# 🔍 监控和日志配置
# -----------------------------------------------------------------------------
# 错误追踪 (Sentry)
SENTRY_DSN='https://REPLACE_WITH_SENTRY_DSN@sentry.io/PROJECT_ID'
SENTRY_ENVIRONMENT='production'

# 日志级别
LOG_LEVEL='info'
ENABLE_DEBUG_LOGS=false

# 性能监控
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# ☁️ 云服务配置
# -----------------------------------------------------------------------------
# AWS S3 (如果使用)
AWS_ACCESS_KEY_ID='REPLACE_WITH_AWS_KEY'
AWS_SECRET_ACCESS_KEY='REPLACE_WITH_AWS_SECRET'
AWS_S3_BUCKET='your-production-bucket'
AWS_REGION='us-east-1'

# Redis缓存 (如果使用)
REDIS_URL='redis://username:password@your-redis-host:6379'

# -----------------------------------------------------------------------------
# 🔧 应用程序配置
# -----------------------------------------------------------------------------
# Next.js优化
NEXT_TELEMETRY_DISABLED=1
ANALYZE_BUNDLE=false

# 缓存配置
CACHE_MAX_AGE=3600
CDN_URL='https://cdn.your-domain.com'

# =============================================================================
# 📝 部署前检查清单:
# =============================================================================
# [ ] 所有REPLACE_WITH_*占位符已替换为实际值
# [ ] 数据库连接字符串指向生产数据库
# [ ] Stripe配置指向生产环境产品
# [ ] DNS记录已配置指向生产服务器
# [ ] SSL证书已安装并验证
# [ ] 监控和告警已配置
# [ ] 备份策略已实施
# [ ] 安全扫描已通过
# =============================================================================